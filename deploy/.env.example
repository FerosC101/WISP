# Copy to deploy/.env on the server. Never commit the real .env.

# Public hostname for the API. It must point at this server (an A record). Without a domain, sslip.io works:
# for a server at 203.0.113.10 use 203-0-113-10.sslip.io
WISP_API_DOMAIN=api.example.com

# Your Vercel site (comma-separated if several). Must match exactly, including https://.
WISP_CORS_ORIGINS=https://wisp.vercel.app
# Optional: also allow this project's Vercel preview deployments.
WISP_CORS_ORIGIN_REGEX=^https://wisp-[a-z0-9-]+\.vercel\.app$

# Shared secret for the MCP tools API (WorkBuddy). Generate: openssl rand -hex 24
WISP_MCP_TOKEN=

# Optional: Tencent Hunyuan (OpenAI-compatible) for free-text extraction. Symptom text is then sent to that service.
WISP_LLM_BASE_URL=
WISP_LLM_API_KEY=
