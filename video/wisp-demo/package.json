{
  "name": "wisp-demo-video",
  "private": true,
  "version": "1.0.0",
  "description": "WISP 5-minute illustrated demo film (Remotion)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts WispDemo",
    "render": "remotion render src/index.ts WispDemo out/wisp-demo-video.mp4 --codec h264 --crf 18",
    "typecheck": "tsc --noEmit",
    "prepare-audio": "node scripts/prepare-audio.mjs",
    "srt": "node scripts/make-srt.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/paths": "4.0.535",
    "@remotion/shapes": "^4.0.535",
    "@remotion/transitions": "^4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
